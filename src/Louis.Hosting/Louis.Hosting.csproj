<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Integration of L.o.U.I.S. with Microsoft.Extensions.Hosting.</Description>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net48;net10.0;net11.0</TargetFrameworks>
    <UseTfmSpecificPublicApiFiles>false</UseTfmSpecificPublicApiFiles>
  </PropertyGroup>

  <!--
      PrivateAssets leaves the analyzers out of its default value, so that the dependency on the Louis package
      brings the source generator and the analyzers of Louis to a project that references this package alone.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Louis\Louis.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Diagnostics" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
