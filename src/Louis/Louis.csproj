<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Essential building blocks for C# libraries and applications.</Description>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net48;net10.0;net11.0</TargetFrameworks>
    <EmitCompilerGeneratedFiles Condition="'$(Configuration)' == 'Debug'">true</EmitCompilerGeneratedFiles>
    <UseTfmSpecificPublicApiFiles>true</UseTfmSpecificPublicApiFiles>
    <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Diagnostics" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <!--
      Louis.Generators holds the source generator and the analyzers of the package.
      The reference makes the compiler run them on this project, and adds no dependency to the package.
      The None item packs the assembly in the folder that a compiler of version 5.0 or later loads analyzers from.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Louis.Generators\Louis.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="..\Louis.Generators\bin\$(Configuration)\netstandard2.0\Louis.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/roslyn5.0/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.Memory" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.Memory" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

</Project>
