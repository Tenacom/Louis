<Project>

  <!--
    SourceLink. The .NET SDK bundles the Microsoft.SourceLink.GitHub package since .NET 8, so no package reference is needed.
    No condition on IsPackable: Buildvana SDK sets its default after this file, so the property has no final value here.
    IncludeSymbols and SymbolPackageFormat act at pack time alone.
  -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
