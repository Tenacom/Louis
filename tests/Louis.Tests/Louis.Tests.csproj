<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- The .NET Framework build is tested on Windows alone: the Linux runner has no .NET Framework runtime. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net48</TargetFrameworks>
    <CLSCompliant>false</CLSCompliant>
    <ImplicitUsings>true</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Louis\Louis.csproj" />
  </ItemGroup>

  <!--
      The tests of ProcessRunner run Louis.Tests.ChildProcess as a child process, from the output directory.
      ProcessRunner exists in the net10.0 build of Louis alone.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\Louis.Tests.ChildProcess\Louis.Tests.ChildProcess.csproj" />
  </ItemGroup>

</Project>
