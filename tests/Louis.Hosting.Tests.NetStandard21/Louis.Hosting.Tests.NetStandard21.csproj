<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the tests of Louis.Hosting.Tests against the netstandard2.1 build of Louis.Hosting. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <CLSCompliant>false</CLSCompliant>
    <ImplicitUsings>true</ImplicitUsings>
    <DefineConstants>$(DefineConstants);LOUIS_NETSTANDARD2_1</DefineConstants>
    <!--
        The SDK adds the project references of Louis.Hosting to this project without SetTargetFramework,
        which would bring in the net10.0 build of Louis. Every project reference is explicit below instead.
    -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Louis.Hosting.Tests\**\*.cs" Exclude="..\Louis.Hosting.Tests\bin\**;..\Louis.Hosting.Tests\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Louis\Louis.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
    <ProjectReference Include="..\..\src\Louis.Hosting\Louis.Hosting.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
  </ItemGroup>

</Project>
