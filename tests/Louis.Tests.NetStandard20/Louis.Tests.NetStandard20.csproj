<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the tests of Louis.Tests against the netstandard2.0 build of Louis. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <!--
        A test copies the #if of the member it tests, so this project defines the symbols of the build it tests
        instead of the symbols of its own target framework.
    -->
    <DisableImplicitFrameworkDefines>true</DisableImplicitFrameworkDefines>
    <DefineConstants>$(DefineConstants);NETSTANDARD;NETSTANDARD2_0;NETSTANDARD2_0_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Louis.Tests\**\*.cs" Exclude="..\Louis.Tests\bin\**;..\Louis.Tests\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <!--
        The netstandard2.0 build of Louis references Microsoft.Bcl.AsyncInterfaces, Microsoft.Bcl.Memory,
        and Microsoft.Bcl.TimeProvider.
        NuGet restore ignores SetTargetFramework and follows the build nearest to the framework of this project.
        That build references none of these packages, so this project references them itself.
    -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.Memory" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Louis\Louis.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <!-- The compiler runs the source generator of Louis on this project, as it does on a project that references the Louis package. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Louis.Generators\Louis.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
