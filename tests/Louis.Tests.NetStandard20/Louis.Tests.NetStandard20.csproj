<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the tests of Louis.Tests against the netstandard2.0 build of Louis. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <CLSCompliant>false</CLSCompliant>
    <ImplicitUsings>true</ImplicitUsings>
    <!--
        A test copies the #if of the member it tests, so this project defines the symbols of the build it tests
        instead of the symbols of its own target framework.
    -->
    <DisableImplicitFrameworkDefines>true</DisableImplicitFrameworkDefines>
    <DefineConstants>$(DefineConstants);NETSTANDARD;NETSTANDARD2_0;NETSTANDARD2_0_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Louis.Tests\**\*.cs" Exclude="..\Louis.Tests\bin\**;..\Louis.Tests\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <!--
        The netstandard2.0 build of Louis references Microsoft.Bcl.AsyncInterfaces. NuGet restore ignores SetTargetFramework
        and follows the net10.0 build, which does not reference the package, so this project references it itself.
    -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Louis\Louis.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
