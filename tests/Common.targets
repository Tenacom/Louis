<Project>

  <!-- Common build options for test projects -->
  <PropertyGroup Condition="'$(IsTestingPlatformApplication)' == 'true'">

    <!--
        Test assemblies are not going to interoperate much.
        Besides, the type names used in test projects are not apt to cause ambiguities.
        Therefore there is no need for a root namespace: let's save ourselves some declarations.
    -->
    <RootNamespace />

    <!-- No need for public API analyzers -->
    <UsePublicApiAnalyzers>false</UsePublicApiAnalyzers>

    <!-- No sense in packing test projects -->
    <IsPackable>false</IsPackable>

    <!-- Common.props turns trimming on for the packaged libraries. A test project is an application that runs as built. -->
    <IsTrimmable>false</IsTrimmable>

    <!-- Suppress warnings that have no business being enforced here. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn> <!-- Do not directly await a Task - A test project has no synchronization context. -->

  </PropertyGroup>

  <!-- Hide test result files in Visual Studio -->
  <ItemGroup Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <None Remove="TestResults\**" />
  </ItemGroup>

</Project>
