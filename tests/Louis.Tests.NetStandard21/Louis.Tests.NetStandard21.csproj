<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the tests of Louis.Tests against the netstandard2.1 build of Louis. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <CLSCompliant>false</CLSCompliant>
    <ImplicitUsings>true</ImplicitUsings>
    <DefineConstants>$(DefineConstants);LOUIS_NETSTANDARD2_1</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Louis.Tests\**\*.cs" Exclude="..\Louis.Tests\bin\**;..\Louis.Tests\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Louis\Louis.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
  </ItemGroup>

</Project>
