<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The reference assemblies of .NET Standard 2.0, for the compilations of the tests. -->
    <PackageReference Include="Basic.Reference.Assemblies.NetStandard20" />
    <!-- The compiler supplies Roslyn to Louis.Generators when it loads the assembly. A test has to bring its own. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Louis\Louis.csproj" />
    <ProjectReference Include="..\..\src\Louis.Generators\Louis.Generators.csproj" />
  </ItemGroup>

  <!-- The test that compares the reference page of the diagnostics with the descriptors reads the page from the output directory. -->
  <ItemGroup>
    <None Include="..\..\docs\diagnostics.md" Link="docs\diagnostics.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
