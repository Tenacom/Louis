<Project Sdk="Microsoft.NET.Sdk">

  <!-- The program that the tests of Louis.Processes run as a child process. Louis.Tests starts it as "dotnet <dll>". -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <CLSCompliant>false</CLSCompliant>
    <ImplicitUsings>true</ImplicitUsings>
    <!-- As in a test project: no root namespace, and no trimming of a program that runs as built. -->
    <RootNamespace />
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

</Project>
