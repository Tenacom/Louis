<Project Sdk="Microsoft.NET.Sdk">

  <!-- The program that the tests of Louis.Processes run as a child process. Louis.Tests starts it as "dotnet <dll>". -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>true</ImplicitUsings>
    <!-- As in a test project: no root namespace. -->
    <RootNamespace />
  </PropertyGroup>

</Project>
